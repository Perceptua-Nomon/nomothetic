[Unit]
Description=nomon REST API server (central mode)
After=network.target

[Service]
Type=simple
Environment=NOMON_SERVICE_USER=nomon NOMON_SERVICE_GROUP=nomon
EnvironmentFile=/etc/nomothetic/nomothetic.env
User=${NOMON_SERVICE_USER}
Group=${NOMON_SERVICE_GROUP}

# Adjust these paths to match your deployment:
WorkingDirectory=/opt/nomothetic
ExecStart=/opt/nomothetic/.venv/bin/uvicorn nomothetic.api:create_app --factory --host 0.0.0.0 --port 443 --ssl-keyfile /etc/nomothetic/tls/key.pem --ssl-certfile /etc/nomothetic/tls/cert.pem

# Required — central mode needs JWT secret and database credentials.
Environment=NOMON_API_MODE=central

# Port 443 requires this capability when running as non-root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
