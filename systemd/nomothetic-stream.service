[Unit]
Description=nomon MJPEG stream server
After=network.target

[Service]
Type=simple
User=nomon
Group=nomon

# Adjust these paths to match your deployment:
WorkingDirectory=/opt/nomothetic
ExecStart=/opt/nomothetic/.venv/bin/python -c "from nomothetic.streaming import StreamServer; StreamServer(host='0.0.0.0', port=8000).start()"

# Optional env file — service starts even if the file is absent.
EnvironmentFile=-/etc/nomothetic/nomothetic.env

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
