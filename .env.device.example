# nomothetic device mode environment variables
# Copy to .env.device: cp .env.device.example .env.device
# .env.device is gitignored — never commit secrets or credentials here.

# =============================================================================
# Deployment (scripts/deploy.sh --mode device)
# =============================================================================

# SSH target for the Raspberry Pi — "user@hostname" or plain IP.
# Required for remote deployment.
# NOMON_PI_HOST=pi@raspberrypi.local
NOMON_PI_HOST=

# Optional path to an SSH private key.
# NOMON_SSH_KEY=~/.ssh/id_ed25519
NOMON_SSH_KEY=

# Optional sudo password for non-interactive remote sudo.
# Leave empty to use interactive sudo prompts.
# NOMON_SUDO_PASS='replace_with_pi_user_password'
NOMON_SUDO_PASS=

# Optional absolute path to the nomothetic repo on the remote Pi.
# Default: ${HOME}/perceptua-nomon/nomothetic
# NOMON_REMOTE_DIR=/home/pi/perceptua-nomon/nomothetic

# Service user / group for systemd service units.
# NOMON_SERVICE_USER=nomon
# NOMON_SERVICE_GROUP=nomon

# =============================================================================
# API Mode
# =============================================================================

NOMON_API_MODE=device

# Path to nomopractic's Wi-Fi Soft AP helper installed on the Pi.
# NOMON_AP_MODE_SCRIPT=/usr/local/bin/ap-mode.sh

# =============================================================================
# Device Authentication
# =============================================================================

# Enable pairing-based authentication for device-mode endpoints.
# NOMON_DEVICE_AUTH=true

# Path to the device JWT signing key on the Pi.
# NOMON_DEVICE_JWT_SECRET_PATH=/var/lib/nomon/device_jwt_secret

# Path to the one-time pairing secret on the Pi.
# NOMON_PAIRING_SECRET_PATH=/var/lib/nomon/pairing_secret

# =============================================================================
# CORS
# =============================================================================

# Comma-separated allowed origins. Defaults to https://10.0.0.1:8443 if unset.
# NOMON_CORS_ORIGINS=http://localhost:8081,https://localhost:8081

# =============================================================================
# TLS Certificate
# =============================================================================

# Additional hostnames/IPs in the self-signed cert's SAN list.
# NOMON_TLS_EXTRA_HOSTS=myhost.example.com,10.0.0.5

# =============================================================================
# Media Storage
# =============================================================================

# NOMON_MEDIA_DIR=~/perceptua-nomon/media

# =============================================================================
# Audio
# =============================================================================

# NOMON_AUDIO_INPUT_INDEX=2
# NOMON_AUDIO_VOLUME=80
# NOMON_AUDIO_MIC_GAIN=50

# =============================================================================
# MQTT Telemetry
# =============================================================================

# NOMON_MQTT_BROKER=
# NOMON_MQTT_PORT=1883
# NOMON_MQTT_TOPIC=nomon/telemetry
# NOMON_MQTT_INTERVAL=30

# =============================================================================
# Telemetry Device ID
# =============================================================================

# NOMON_DEVICE_ID=
# NOMON_MODEL=
