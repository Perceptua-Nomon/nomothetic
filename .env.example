# nomon Environment Variables
# Copy this file to .env and fill in values.
# .env is gitignored — never commit secrets.
#
# Only secret or deployment-specific values belong here.
# All other settings (server, audio, MQTT, etc.) live in config.toml.

# =============================================================================
# Deployment (scripts/deploy.sh)
# =============================================================================

# SSH target for the Raspberry Pi — "user@hostname" or plain IP.
# Required by scripts/deploy.sh.
NOMON_PI_HOST=perceptua@perceptua

# Optional path to an SSH private key.  Omit to use ssh-agent or the default
# ~/.ssh/id_* identity.
NOMON_SSH_KEY=~/.ssh/id_ed25519

# =============================================================================
# MQTT Credentials
# =============================================================================

# MQTT broker credentials — only needed when the broker requires authentication.
# The broker address and non-sensitive MQTT settings live in config.toml [mqtt].
# NOMON_MQTT_USERNAME=
# NOMON_MQTT_PASSWORD=

# =============================================================================
# Authentication
# =============================================================================

# Secret key for JWT token signing — generate with: openssl rand -hex 32
# NOMON_JWT_SECRET=

# Token expiry in seconds (default: 3600 = 1 hour)
# NOMON_JWT_EXPIRY=3600

# Comma-separated list of allowed API keys
# NOMON_API_KEYS=
