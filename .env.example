# nomothetic Environment Variables
# Copy this file to .env and fill in values.
# .env is gitignored — never commit secrets or credentials here.
#
# IMPORTANT: This file is for deployment-specific values ONLY.
# All non-sensitive configuration (server host/port, media dir, audio devices, MQTT settings,
# telemetry settings, etc.) is in config.toml and ready to use when you clone the repo.
#
# You likely only need to set:
# 1. NOMON_PI_HOST and NOMON_SSH_KEY for remote deployment
# 2. NOMON_REMOTE_DIR if your repo path on the Pi differs from the default

# =============================================================================
# Deployment (scripts/deploy.sh)
# =============================================================================

# SSH target for the Raspberry Pi — "user@hostname" or plain IP.
# Required by scripts/deploy.sh for remote deployment.
# Example: NOMON_PI_HOST=pi@raspberrypi.local
NOMON_PI_HOST=perceptua@perceptua

# Optional path to an SSH private key.  Omit to use ssh-agent or the default
# ~/.ssh/id_* identity.
# Example: NOMON_SSH_KEY=~/.ssh/id_ed25519
NOMON_SSH_KEY=~/.ssh/id_ed25519

# Optional absolute path to the nomothetic repo on the remote Pi.
# Default: ${HOME}/perceptua-nomon/nomothetic
# Only needed if your repo is in a non-standard location on the Pi.
# NOMON_REMOTE_DIR=/home/perceptua/src/nomothetic

