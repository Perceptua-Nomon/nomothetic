# nomothetic Environment Variables
# Copy this file to .env and fill in values.
# .env is gitignored — never commit secrets or credentials here.
#
# IMPORTANT: This file is for deployment-specific values ONLY.
# All non-sensitive configuration (server host/port, media dir, audio devices, MQTT settings,
# telemetry settings, etc.) is in config.toml and ready to use when you clone the repo.
#
# You likely only need to set:
# 1. NOMON_PI_HOST and NOMON_SSH_KEY for remote deployment
# 2. NOMON_REMOTE_DIR if your repo path on the Pi differs from the default

# =============================================================================
# Deployment (scripts/deploy.sh)
# =============================================================================

# SSH target for the Raspberry Pi — "user@hostname" or plain IP.
# Required by scripts/deploy.sh for remote deployment.
# Example: NOMON_PI_HOST=pi@raspberrypi.local
NOMON_PI_HOST=perceptua@perceptua

# Optional path to an SSH private key.  Omit to use ssh-agent or the default
# ~/.ssh/id_* identity.
# Example: NOMON_SSH_KEY=~/.ssh/id_ed25519
NOMON_SSH_KEY=~/.ssh/id_ed25519

# Optional sudo password used by scripts/deploy.sh for non-interactive remote
# sudo operations when the Pi user is not configured for passwordless sudo.
# Leave empty to use interactive sudo prompts.
# Example: NOMON_SUDO_PASS='replace_with_pi_user_password'
NOMON_SUDO_PASS=

# Optional absolute path to the nomothetic repo on the remote Pi.
# Default: ${HOME}/perceptua-nomon/nomothetic
# Only needed if your repo is in a non-standard location on the Pi.
# NOMON_REMOTE_DIR=/home/perceptua/src/nomothetic

# Service user / group for systemd service units.
# These values are used by nomothetic systemd service definitions.
# NOMON_SERVICE_USER=nomon
# NOMON_SERVICE_GROUP=nomon

# =============================================================================
# API Mode
# =============================================================================

# "device" (default) — robot control endpoints on Raspberry Pi.
# "central" — fleet management + auth endpoints on a server.
# NOMON_API_MODE=device

# Path to nomopractic's Wi-Fi Soft AP helper installed on the Pi.
# The nomopractic deploy script installs this to /usr/local/bin/ap-mode.sh.
# NOMON_AP_MODE_SCRIPT=/usr/local/bin/ap-mode.sh

# =============================================================================
# Device Authentication (device mode only)
# =============================================================================

# Enable pairing-based authentication for device-mode endpoints.
# When "true" (default), a one-time pairing secret is printed to the console
# on first boot.  The device owner enters this secret via the nomotactic app
# to claim the device and receive JWT tokens.  All /api/* endpoints then
# require a valid bearer token.
# Set to "false" to disable device auth (endpoints are unauthenticated).
# NOMON_DEVICE_AUTH=true

# =============================================================================
# Authentication (central mode only)
# =============================================================================

# Required when NOMON_API_MODE=central. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# NOMON_JWT_SECRET=

# =============================================================================
# ArcadeDB (central mode only)
# =============================================================================

# Set ARCADEDB_HOST to enable persistent graph storage.
# Omit to use in-memory stores (suitable for dev/test).
# ARCADEDB_HOST=localhost
# ARCADEDB_HTTP_PORT=2480
# ARCADEDB_DATABASE=nomon_central
# Quote passwords that contain shell special characters (& ! $ etc.).
# ARCADEDB_ROOT_PASSWORD=''

# =============================================================================
# CORS
# =============================================================================

# Comma-separated allowed origins. Required for both central and device mode.
# Device mode defaults to https://10.0.0.1:8443 (AP hotspot) if unset.
# For Tailscale / dev-machine access include the Expo dev server origin.
# NOMON_CORS_ORIGINS=http://localhost:8081

# =============================================================================
# TLS Certificate
# =============================================================================

# On startup the API tries to provision a Tailscale-issued TLS cert (Let's
# Encrypt-backed, browser-trusted).  If Tailscale is unavailable it falls back
# to a self-signed cert.  Set NOMON_TLS_EXTRA_HOSTS to include additional
# hostnames/IPs in the self-signed cert's SAN list (comma-separated).
#
# FUTURE: public hosting for users outside the tailnet is not yet supported.
# NOMON_TLS_EXTRA_HOSTS=myhost.example.com,10.0.0.5

# =============================================================================
# Reverse Proxy
# =============================================================================

# Set to "true" to trust X-Forwarded-For headers for rate limiting.
# NOMON_TRUST_PROXY=false

# =============================================================================
# Media Storage
# =============================================================================

# Root directory for photos, videos, and audio recordings.
# NOMON_MEDIA_DIR=~/perceptua-nomon/media

# =============================================================================
# Audio
# =============================================================================

# ALSA device index for USB microphone (PCM2902 = card 2 on Robot HAT V4).
# NOMON_AUDIO_INPUT_INDEX=2

# Default output volume (0–100).
# NOMON_AUDIO_VOLUME=80

# Default microphone capture gain (0–100).
# NOMON_AUDIO_MIC_GAIN=50

# =============================================================================
# MQTT Telemetry
# =============================================================================

# Leave NOMON_MQTT_BROKER empty to disable telemetry publishing.
# NOMON_MQTT_BROKER=
# NOMON_MQTT_PORT=1883
# NOMON_MQTT_TOPIC=nomon/telemetry
# NOMON_MQTT_INTERVAL=30

# =============================================================================
# Telemetry Device ID
# =============================================================================

# Unique identifier for this Pi. Auto-detected from /proc/cpuinfo if empty.
# NOMON_DEVICE_ID=
